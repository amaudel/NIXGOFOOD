# Demo Mode Flag (set true for Vercel demo without Supabase)
NEXT_PUBLIC_DEMO_MODE=true

# Dominio raiz sin protocolo, usado por middleware.ts para clasificar
# hostnames (root / admin.* / {slug}.*). En dev local: "localhost:3000".
ROOT_DOMAIN=localhost:3000

# Dominio de produccion de esta app (sin slash final). Usado por middleware.ts
# (solo server-side, por eso SIN prefijo NEXT_PUBLIC_) para rechazar peticiones
# POST/PUT/DELETE cross-origin hacia /api/* que lleguen desde otro sitio web
# (proteccion CSRF, no reemplaza RLS).
SITE_URL=https://your-domain.vercel.app

# Public Supabase API Credentials (Optional for Demo Mode)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# fal.ai Image Generation API Key
FAL_KEY=your-fal-ai-api-key-here

# URL del Worker del agente de chat (Telegram + Web)
NEXT_PUBLIC_AGENT_CHAT_URL=https://agente-taca-nijo.andresdelgado1984.workers.dev
